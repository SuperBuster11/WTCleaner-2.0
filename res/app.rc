#include <windows.h>
#include "../src/resource.h"

IDI_APPICON ICON "myicon.ico"

// Manifest: nowoczesny wygląd kontrolek (Common Controls 6) + świadomość DPI.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WT Cleaner"
            VALUE "FileVersion", "2.0.0"
            VALUE "InternalName", "WTCleaner"
            VALUE "OriginalFilename", "WT Cleaner.exe"
            VALUE "ProductName", "WT Cleaner"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
